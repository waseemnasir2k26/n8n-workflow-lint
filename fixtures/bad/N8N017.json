{
  "name": "Daily orders",
  "nodes": [
    {
      "id": "fetch-orders",
      "name": "Fetch Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "url": "https://api.example.com/orders",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "shape-order",
      "name": "Shape Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": []
        }
      }
    }
  ],
  "connections": {
    "Fetch Orders": {
      "main": [
        [
          {
            "node": "Shape Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "error-handler-1"
  }
}
